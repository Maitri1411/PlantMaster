    <add name="PlantMasterDBConnectionString" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=PlantMasterDB;Integrated Security=True;TrustServerCertificate=True"
      providerName="System.Data.SqlClient" />
    <add name="PlantMasterDBConnectionString1" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=PlantMasterDB;Integrated Security=True;TrustServerCertificate=True"
      providerName="System.Data.SqlClient" />
    <add name="ConnectionString" connectionString="Data Source=localhost\SQLEXPRESS;Integrated Security=True;TrustServerCertificate=True"
      providerName="System.Data.SqlClient" />
    <add name="PlantMasterDBConnectionString2" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=PlantMasterDB;Integrated Security=True;TrustServerCertificate=True"
      providerName="System.Data.SqlClient" />
    <add name="workReportConnectionString" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=workReport;Integrated Security=True;TrustServerCertificate=True"
      providerName="System.Data.SqlClient" />
    <add name="workreportlistDatasetConnectionString" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=workreportlistDataset;Integrated Security=True;TrustServerCertificate=True"
